# ---------------------------------------------------------------------------
# SGI-ORCB — variáveis de ambiente. Copie para .env e preencha.
# NUNCA versionar valores reais. Em produção, usar Secret Manager.
# ---------------------------------------------------------------------------
NODE_ENV=development
# Ambiente institucional: desenvolvimento | homologacao | producao (padrão em build de produção: producao)
APP_ENV=desenvolvimento
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://sgi_app:senha@localhost:5432/sgi
# true = TLS verificando o certificado; require = TLS sem verificar a cadeia (Cloud SQL por IP privado); false = sem TLS
DATABASE_SSL=false

# Domínio institucional do Google Workspace (somente contas deste domínio podem entrar)
GOOGLE_WORKSPACE_DOMAIN=exemplo-cartorio.com.br
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave de criptografia de campos sensíveis: 32 bytes em base64 (openssl rand -base64 32)
FIELD_ENCRYPTION_KEY=
# Chave HMAC para busca de CPF e assinatura de cookies temporários: 32 bytes em base64
HMAC_KEY=

# Login de desenvolvimento/homologação com usuários FICTÍCIOS. Proibido em produção (a aplicação recusa iniciar).
AUTH_DEV_LOGIN=false

# Antivírus dos anexos (ClamAV/clamd, protocolo TCP). Em produção, sem antivírus, o envio de arquivos é bloqueado.
# Proxies da infraestrutura além do primeiro: 0 = Cloud Run direto ou Caddy/Nginx; 1 = balanceador + Cloud Run
TRUSTED_PROXY_HOPS=0
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# Armazenamento dos arquivos documentais: banco (padrão) | drive (Drive compartilhado do Google Workspace)
DOCUMENT_STORAGE=banco
# ID do Drive compartilhado (parte final da URL drive.google.com/drive/folders/<ID>) e, opcionalmente, de uma pasta dentro dele
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_FOLDER_ID=
# Chave JSON da conta de serviço codificada em base64 (base64 -w0 chave.json). No Cloud Run, deixe vazio:
# a aplicação usa a identidade do próprio serviço, sem chave. Nunca versionar.
GOOGLE_DRIVE_SA_KEY=
